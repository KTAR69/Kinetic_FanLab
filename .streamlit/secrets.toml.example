# Kinetic FanLab — Cloud & watsonx Deployment Secrets Example
# Copy this file to .streamlit/secrets.toml for Streamlit Community Cloud or local testing.

# IBM watsonx.ai Credentials (Dallas us-south region)
WATSONX_APIKEY = "YOUR_IBM_CLOUD_API_KEY"
WATSONX_URL = "https://us-south.ml.cloud.ibm.com"
WATSONX_PROJECT_ID = "YOUR_WATSONX_PROJECT_ID"

# IBM Cloudant NoSQL Credentials
CLOUDANT_APIKEY = "YOUR_CLOUDANT_API_KEY"
CLOUDANT_URL = "https://YOUR_INSTANCE.cloudantnosqldb.appdomain.cloud"

# IBM Cloud Object Storage (COS) Credentials
COS_APIKEY = "YOUR_COS_API_KEY"
COS_RESOURCE_INSTANCE_ID = "YOUR_COS_CRN"
COS_ENDPOINT = "https://s3.us-south.cloud-object-storage.appdomain.cloud"
COS_BUCKET_NAME = "kinetic-fanlab-curated-cmi"
